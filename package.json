{
  "name": "vc-api-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for the VC API monorepo",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive --workspace-concurrency=1 run test",
    "lint": "eslint .",
    "update-openapi": "pnpm --filter @energyweb/ssi-vc-api run update-openapi",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-no-only-tests": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "pretty-quick": "^4.0.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
